# ── Database ──
# DATABASE_URL=postgres://user:pass@host/db   # Postgres (Neon on Vercel). Unset = local SQLite

# ── Server ──
PORT=4300
# DATA_DIR=./data                 # where the SQLite database lives

# ── Security ──
# API_TOKEN=change-me             # optional shared token; the browser prompts for it once
# ALLOW_PRIVATE_HOSTS=false       # true ONLY for local dev (lets you audit localhost / staging on a private IP)

# ── Crawler limits ──
# MAX_PAGES_HARD=500              # absolute cap per audit, whatever the UI asks for
# CRAWL_CONCURRENCY=3             # parallel page fetches per audit
# CRAWL_DELAY_MS=200              # politeness delay between requests to the same host
# MAX_CONCURRENT_AUDITS=2         # extra audits queue
# MAX_INTERNAL_LINK_CHECKS=150
# MAX_EXTERNAL_LINK_CHECKS=100
# MAX_IMAGE_CHECKS=80
# CRAWL_TIME_BUDGET_MS=200000   # stop discovering pages after this long (defaults to 200s on Vercel, unlimited elsewhere)

# ── Integrations (optional) ──
# ANTHROPIC_API_KEY=sk-ant-...    # enables the Claude-powered SEO assistant + AI fix suggestions
# ANTHROPIC_MODEL=claude-sonnet-5-5
# PAGESPEED_API_KEY=...           # enables LCP / INP / CLS checks via Google PageSpeed Insights
